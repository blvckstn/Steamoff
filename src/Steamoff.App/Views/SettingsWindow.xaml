<Window x:Class="Steamoff.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Steamoff.Core.Models;assembly=Steamoff.Core"
        xmlns:conv="clr-namespace:Steamoff.App.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding Loc[settings.title]}"
        Width="640" Height="720" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        Closing="OnWindowClosing">
    <Window.Resources>
        <conv:LanguageEqualityConverter x:Key="LanguageEqualityConverter"/>
        <conv:TestOutcomeToBrushConverter x:Key="TestOutcomeToBrushConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:PathCheckStatusToBrushConverter x:Key="PathCheckStatusToBrushConverter"/>
        <conv:LogLineContainsConverter x:Key="LogLineContainsConverter"/>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LanguageCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource LanguageEqualityConverter}">
                            <Binding/>
                            <Binding Path="DataContext.SelectedLanguage" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Style="{StaticResource HeadingTextStyle}" Text="{Binding Loc[settings.title]}" Margin="0,0,0,14"/>

        <!-- Language bar — topmost element above all settings sections -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="14">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{Binding Loc[language.bar.title]}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Languages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AppLanguage}">
                                <Border Style="{StaticResource LanguageCardStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FlagEmoji}" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayCode}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding NativeName}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Margin="0,10,0,0" Visibility="{Binding IsRestartRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource WarningBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="{Binding Loc[settings.language.restartWarning]}"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"
                            Content="{Binding Loc[settings.button.restartNow]}" Command="{Binding RestartNowCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Scrollable settings sections -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Modes / behavior -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{Binding Loc[settings.section.modes]}"/>
                        <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,4" Content="{Binding Loc[settings.blockInbound]}"
                                  ToolTipService.ToolTip="{Binding Loc[settings.tooltip.blockInbound]}"
                                  IsChecked="{Binding BlockInbound}"/>
                        <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,4" Content="{Binding Loc[settings.blockAllExeInSteamFolder]}"
                                  ToolTipService.ToolTip="{Binding Loc[settings.tooltip.blockAllExeInSteamFolder]}"
                                  IsChecked="{Binding BlockAllExecutablesInSteamFolder}"/>
                        <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,4" Content="{Binding Loc[settings.warnBeforeUnblock]}"
                                  ToolTipService.ToolTip="{Binding Loc[settings.tooltip.warnBeforeUnblock]}"
                                  IsChecked="{Binding WarnBeforeUnblock}"/>
                    </StackPanel>
                </Border>

                <!-- Firewall rule application strategy -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                       Text="{Binding Loc[settings.section.firewallStrategy]}"/>
                            <ComboBox Grid.Column="1" Width="170"
                                      Background="{StaticResource SurfaceElevatedBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderDarkBrush}"
                                      ItemsSource="{Binding FirewallStrategyModeOptions}"
                                      SelectedIndex="{Binding FirewallStrategyModeIndex}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="{Binding Loc[settings.firewallStrategy.description]}"/>
                    </StackPanel>
                </Border>

                <!-- Steam path -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                       Text="{Binding Loc[settings.section.steamPath]}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                        Content="{Binding Loc[settings.steamPath.autoFind]}" Command="{Binding AutoFindSteamCommand}"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding Loc[settings.button.browseFolder]}" Command="{Binding BrowseSteamFolderCommand}"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="SteamPathDropZone" AllowDrop="True"
                                Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource ControlRadius}"
                                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="10,8">
                            <StackPanel>
                                <TextBox x:Name="SteamPathTextBox" Style="{StaticResource DarkTextBoxStyle}" Background="Transparent" BorderThickness="0" Padding="0"
                                         Text="{Binding SteamPath, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="OnSteamPathLostFocus"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding SteamPathStatus, Converter={StaticResource PathCheckStatusToBrushConverter}}"/>
                                    <TextBlock Text="{Binding SteamPathStatusText}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Loc[settings.steamPath.dropHint]}" Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Folders -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel x:Name="FoldersDropZone" AllowDrop="True">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                           Text="{Binding Loc[settings.section.folders]}"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding Loc[settings.section.folders.description]}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AddItemButtonStyle}"
                                    Command="{Binding AddFolderCommand}" ToolTip="{Binding Loc[settings.button.addFolder]}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Loc[settings.button.addFolder]}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:FolderBlockTarget}">
                                    <Border Style="{StaticResource ListRowCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource DarkCheckBoxStyle}" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" IsChecked="{Binding Enabled}"
                                                      ToolTipService.ToolTip="{Binding DataContext.Loc[settings.tooltip.folderToggle], RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding DiscoveredExeCount, Mode=OneWay}"/>
                                                    <Run Text=" exe"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextStyle}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionTextStyle}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowActionButtonStyle}" Content="&#x21BB;"
                                                        ToolTip="{Binding DataContext.Loc[settings.button.rescan], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.RescanFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowActionButtonStyle}" Content="&#x1F4C2;"
                                                        ToolTip="{Binding DataContext.Loc[settings.button.openInExplorer], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.OpenFolderLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowActionButtonStyle}" Content="&#x2715;"
                                                        ToolTip="{Binding DataContext.Loc[settings.button.delete], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding Folders.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding Loc[settings.folders.empty.title]}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[settings.folders.empty.subtitle]}" Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Standalone EXE files -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel x:Name="ExeDropZone" AllowDrop="True">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                           Text="{Binding Loc[settings.section.exeFiles]}"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding Loc[settings.section.exeFiles.description]}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AddItemButtonStyle}"
                                    Command="{Binding AddExeCommand}" ToolTip="{Binding Loc[settings.button.addExe]}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Loc[settings.button.addExe]}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Executables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ExeBlockTarget}">
                                    <Border Style="{StaticResource ListRowCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource DarkCheckBoxStyle}" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" IsChecked="{Binding Enabled}"
                                                      ToolTipService.ToolTip="{Binding DataContext.Loc[settings.tooltip.exeToggle], RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextStyle}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionTextStyle}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowActionButtonStyle}" Content="&#x21BB;"
                                                        ToolTip="{Binding DataContext.Loc[common.status], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.CheckExeStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowActionButtonStyle}" Content="&#x1F4C2;"
                                                        ToolTip="{Binding DataContext.Loc[settings.button.openInExplorer], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.OpenExeLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowActionButtonStyle}" Content="&#x2715;"
                                                        ToolTip="{Binding DataContext.Loc[settings.button.delete], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.RemoveExeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding Executables.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding Loc[settings.exe.empty.title]}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[settings.exe.empty.subtitle]}" Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Autostart -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{Binding Loc[settings.section.autostart]}"/>
                        <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,4" Content="{Binding Loc[settings.startWithWindows]}"
                                  IsChecked="{Binding StartWithWindows}"/>
                        <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,4" Content="{Binding Loc[settings.startMinimizedToTray]}"
                                  IsChecked="{Binding StartMinimizedToTray}"/>
                    </StackPanel>
                </Border>

                <!-- Testing & status -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{Binding Loc[settings.section.testing]}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding Loc[common.testing]}" Command="{Binding TestCommand}"/>
                        </Grid>

                        <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding LastReport.OverallOutcome, Converter={StaticResource TestOutcomeToBrushConverter}}"/>
                                    <TextBlock Text="{Binding StatusSummaryText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LastRunText}" Style="{StaticResource CaptionTextStyle}"/>
                                <ItemsControl ItemsSource="{Binding LastReport.Checks}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DiagnosticCheckResult}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Fill="{Binding Outcome, Converter={StaticResource TestOutcomeToBrushConverter}}"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Journal / Log -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                       Text="{Binding Loc[settings.journal.title]}"/>
                            <ComboBox Grid.Column="1" Width="170"
                                      Background="{StaticResource SurfaceElevatedBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderDarkBrush}"
                                      ItemsSource="{Binding JournalFilterOptions}"
                                      SelectedIndex="{Binding JournalFilterIndex}"/>
                        </Grid>

                        <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource ControlRadius}"
                                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="10,8" MinHeight="160" MaxHeight="260">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasJournalLines, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding JournalLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource LogLineContainsConverter}, ConverterParameter=[ERROR]}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource RedStatusBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource LogLineContainsConverter}, ConverterParameter=[WARN]}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource LogLineContainsConverter}, ConverterParameter=[INFO]}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource GreenStatusBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="{Binding Loc[settings.journal.empty]}" Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasJournalLines, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                    Content="{Binding Loc[settings.journal.refresh]}" Command="{Binding RefreshJournalCommand}"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                    Content="{Binding Loc[settings.journal.openFolder]}" Command="{Binding OpenLogFolderCommand}"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                    Content="{Binding Loc[settings.journal.copyDiagnostics]}" Command="{Binding CopyDiagnosticsCommand}"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding Loc[settings.journal.clearDisplay]}" Command="{Binding ClearJournalDisplayCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast + Apply / Save / Cancel -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Toast}" Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource AccentOrangeBrush}" VerticalAlignment="Center"
                       Visibility="{Binding Toast, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Content="{Binding Loc[common.cancel]}" Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Content="{Binding Loc[common.apply]}" Command="{Binding ApplyCommand}"/>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="{Binding Loc[common.save]}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
