<Window x:Class="Steamoff.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Steamoff.App.Converters"
        xmlns:enums="clr-namespace:Steamoff.Core.Enums;assembly=Steamoff.Core"
        xmlns:status="clr-namespace:Steamoff.App.Status"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding Loc[app.title]}"
        Width="380" Height="700" MinWidth="320" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        Closing="OnWindowClosing">
    <Window.Resources>
        <conv:HealthLevelToBrushConverter x:Key="HealthLevelToBrushConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:LogLineContainsConverter x:Key="LogLineContainsConverter"/>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MainStatusCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#2A2B34"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.Overall}" Value="{x:Static enums:OverallStatus.FullyUnblocked}">
                    <Setter Property="BorderBrush" Value="#3EBC78"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="MainOnlinePulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#284B38" Duration="0:0:1.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="MainOnlinePulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Overall}" Value="{x:Static enums:OverallStatus.FullyBlocked}">
                    <Setter Property="BorderBrush" Value="#FF9F1A"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="MainOfflinePulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#5A3A1D" Duration="0:0:1.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="MainOfflinePulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#30313B"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.Overall}" Value="{x:Static enums:OverallStatus.FullyUnblocked}">
                    <Setter Property="BorderBrush" Value="#3EBC78"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="OnlinePulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#284B38" Duration="0:0:1.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="OnlinePulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Overall}" Value="{x:Static enums:OverallStatus.FullyBlocked}">
                    <Setter Property="BorderBrush" Value="#FF9F1A"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="OfflinePulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#5A3A1D" Duration="0:0:1.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="OfflinePulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Overall}" Value="{x:Static enums:OverallStatus.Error}">
                    <Setter Property="BorderBrush" Value="{StaticResource RedStatusBrush}"/>
                    <Setter Property="Background" Value="#3B252A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Overall}" Value="{x:Static enums:OverallStatus.DriftDetected}">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                    <Setter Property="Background" Value="#3B3424"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivitySpinnerStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource HeadingTextStyle}" Text="{Binding Loc[compact.title]}"/>
                <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="{Binding Loc[compact.subtitle]}" Margin="0,2,0,0"/>
            </StackPanel>
            <status:RobotStatusIcon Grid.Column="1" Width="66" Height="66" Margin="8,-10,8,-8"
                                    VerticalAlignment="Center" StatusKind="{Binding StatusIconKind}"/>
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{Binding OpenSettingsCommand}"
                    ToolTipService.ToolTip="{Binding Loc[compact.tooltip.settingsButton]}" Content="⚙" FontSize="18"/>
        </Grid>

        <!-- Status card -->
        <Border Grid.Row="1" Style="{StaticResource MainStatusCardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding Level, Converter={StaticResource HealthLevelToBrushConverter}}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-6,0,12"
                            Visibility="{Binding IsActivityVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⟳" Style="{StaticResource ActivitySpinnerStyle}" Width="20" Height="20"
                               TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ActivityText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding CoverageText}" FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"
                           Visibility="{Binding CoverageText, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="{Binding CoverageDetailText}" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"
                           Visibility="{Binding CoverageDetailText, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="{Binding OfflineModeTitle}" Style="{StaticResource SectionHeaderStyle}"
                           HorizontalAlignment="Center" Margin="0,16,0,10"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BigToggleButtonStyle}"
                            Command="{Binding EnableOfflineCommand}"
                            ToolTipService.ToolTip="{Binding Loc[compact.tooltip.toggleButton]}"
                            Background="{StaticResource AccentOrangeBrush}">
                        <TextBlock Text="{Binding OfflineOnButtonText}" Foreground="#1B1B1F" FontWeight="SemiBold" FontSize="18"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource BigToggleButtonStyle}"
                            Command="{Binding DisableOfflineCommand}"
                            ToolTipService.ToolTip="{Binding Loc[compact.tooltip.toggleButton]}"
                            Background="{StaticResource GreenStatusBrush}">
                        <TextBlock Text="{Binding OfflineOffButtonText}" Foreground="#1B1B1F" FontWeight="SemiBold" FontSize="18"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Admin / firewall indicator -->
        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"
                             Fill="{Binding HasAdminAccess, Converter={StaticResource HealthLevelToBrushConverter}}"/>
                    <TextBlock Text="{Binding AdminStatusText}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14,10"
                    Visibility="{Binding IsRestartRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding Loc[compact.languageRestart.banner]}" Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Mini-log -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                               Text="{Binding Loc[compact.miniLog.title]}"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                            Content="{Binding ExpandLogButtonText}" Command="{Binding ExpandLogCommand}"
                            ToolTipService.ToolTip="{Binding Loc[compact.tooltip.expandLog]}"/>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource ControlRadius}"
                        BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="10,8" MinHeight="80">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasRecentLogLines, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding RecentLogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource LogLineContainsConverter}, ConverterParameter=[ERROR]}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource RedStatusBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource LogLineContainsConverter}, ConverterParameter=[WARNING]}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource LogLineContainsConverter}, ConverterParameter=[INFO]}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource GreenStatusBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{Binding Loc[compact.miniLog.empty]}" Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasRecentLogLines, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Content="{Binding Loc[compact.miniLog.openFull]}" Command="{Binding OpenFullLogCommand}"
                            ToolTipService.ToolTip="{Binding Loc[compact.tooltip.openFullLog]}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding Loc[compact.miniLog.copyDiagnostics]}" Command="{Binding CopyDiagnosticsCommand}"
                            ToolTipService.ToolTip="{Binding Loc[compact.tooltip.copyDiagnostics]}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                    Content="{Binding Loc[compact.settingsButton]}" Command="{Binding OpenSettingsCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
