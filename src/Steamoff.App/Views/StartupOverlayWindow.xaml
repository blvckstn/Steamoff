<Window x:Class="Steamoff.App.Views.StartupOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:status="clr-namespace:Steamoff.App.Status"
        Width="220" Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Border Width="180" Height="180"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="28"
                Background="#DD202128"
                BorderBrush="#66FF9F1A"
                BorderThickness="1">
            <Grid>
                <status:RobotStatusIcon Width="118" Height="118"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        StatusKind="{Binding CurrentIcon}"/>
                <Path Width="142" Height="142"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stroke="#FFFF9F1A"
                      StrokeThickness="5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeDashArray="0.25 0.9"
                      Data="M71,4 A67,67 0 1 1 70.9,4"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
        </Border>
    </Grid>
</Window>
