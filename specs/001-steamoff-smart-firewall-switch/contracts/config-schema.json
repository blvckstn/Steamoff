{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Steamoff settings.json",
  "type": "object",
  "required": ["version", "desiredState", "enforcementMode"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "desiredState": { "type": "string", "enum": ["Blocked", "Unblocked"] },
    "enforcementMode": {
      "type": "string",
      "enum": ["ManualToggle", "AlwaysBlock", "AlwaysUnblock", "PauseMonitoring"]
    },
    "steamPath": { "type": ["string", "null"] },
    "blockInbound": { "type": "boolean", "default": false },
    "ruleCleanupMode": {
      "type": "string",
      "enum": ["DisableRules", "DeleteRules"],
      "default": "DisableRules"
    },
    "checkIntervalSeconds": { "type": "integer", "minimum": 5, "default": 15 },
    "startWithWindows": { "type": "boolean", "default": true },
    "startMinimizedToTray": { "type": "boolean", "default": true },
    "applySavedStateOnStartup": { "type": "boolean", "default": true },
    "warnBeforeUnblock": { "type": "boolean", "default": true },
    "autoRestoreWhenAlwaysBlock": { "type": "boolean", "default": true },
    "blockAllExecutablesInSteamFolder": { "type": "boolean", "default": false },
    "additionalFolders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "enabled", "recursive"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "enabled": { "type": "boolean" },
          "recursive": { "type": "boolean" }
        }
      }
    },
    "additionalExecutables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "enabled"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "enabled": { "type": "boolean" },
          "addedAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "theme": { "type": "string", "default": "DarkOrange" },
        "closeToTray": { "type": "boolean", "default": true }
      }
    }
  }
}
